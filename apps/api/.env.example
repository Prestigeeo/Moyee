ENV=local
# Supabase -> Project Settings -> Database -> Connection string (URI).
# Use the Session Pooler URI and replace the scheme with postgresql+psycopg://
# Leave as sqlite:///./moyee_local.db to run locally without Supabase.
DATABASE_URL=sqlite:///./moyee_local.db

# Supabase -> Project Settings -> API
SUPABASE_URL=
# Only needed if your project uses the legacy HS256 JWT secret
SUPABASE_JWT_SECRET=

# AI Providers (Google AI Studio / Groq)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Paystack (Test Mode)
PAYSTACK_SECRET_KEY=sk_test_moyee_dev
PAYSTACK_PUBLIC_KEY=

WEB_ORIGIN=http://localhost:3000
OPENALEX_MAILTO=
